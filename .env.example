# Copy to .env; generate SECRET_KEY with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///stocksense.db
# Demo passwords are set by YOU, never included in Git.
DEMO_OWNER_PASSWORD=
DEMO_STAFF_PASSWORD=
# Optional absolute persistent directory; defaults to instance/uploads
# UPLOAD_DIR=/absolute/path/to/uploads
# APP_ENV=production

# Ask StockSense (owner-only). Built-in mode works without a model.
ASK_PROVIDER=builtin
# Local AI: install Ollama, run `ollama pull llama3.2`, then set ASK_PROVIDER=ollama.
ASK_OLLAMA_MODEL=llama3.2:latest
# Optional cloud interpreter: ASK_PROVIDER=gemini, add your private API key.
GEMINI_API_KEY=
ASK_GEMINI_MODEL=gemini-3.5-flash-lite
