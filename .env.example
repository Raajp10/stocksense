# Copy to .env; generate SECRET_KEY with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///stocksense.db
# Demo passwords are set by YOU, never included in Git.
DEMO_OWNER_PASSWORD=
DEMO_STAFF_PASSWORD=
# Optional absolute persistent directory; defaults to instance/uploads
# UPLOAD_DIR=/absolute/path/to/uploads
# APP_ENV=production
